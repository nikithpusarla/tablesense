# Copy to .env and fill in to enable WhatsApp alerts (also set whatsapp.enabled: true in config.yaml).
# Get these from https://console.twilio.com  (WhatsApp sandbox works for testing).
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TOKEN=your_auth_token
TWILIO_FROM=whatsapp:+14155238886
# One or more recipients, comma-separated
TWILIO_TO=whatsapp:+919800000000
